{
  "name": "orkneytech-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Orkneytech Lab (Next.js static export + formulário PHP/SQLite)",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/package-dist.mjs",
    "preview": "node scripts/serve-static.mjs dist/public 4173",
    "preview:php": "php -S 127.0.0.1:8080 -t dist/public",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:php": "php php/tests/run.php",
    "test:e2e": "playwright test",
    "db:migrate": "php php/bin/migrate.php",
    "db:messages": "php php/bin/list-messages.php"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prettier": "^3.6.0",
    "vitest": "^3.2.0"
  }
}
